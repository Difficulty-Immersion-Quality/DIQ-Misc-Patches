    if IsSpellChildOrVariantFromContext('Target_CallLightning_LightningBolt_8').Result      then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_CallLightning_LightningBolt_9').Result      then return ConditionResult(true) end
