    if IsSpellChildOrVariantFromContext('Target_Moonbeam_Move').Result                      then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Moonbeam_Move_3').Result                    then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Moonbeam_Move_4').Result                    then return ConditionResult(true) end
