-- ==================================== Metamagic fixes ====================================

-- Bug Fix: No longer functions for melee range spells.
function TwinnedProjectileSpellCheck()
    -- return ~NumberOfTargetsGreaterThan(1) & ~AreaRadiusGreaterThan(0) & (HasSpellFlag(SpellFlags.Spell) | NonSpellMetamagicAbilities()) & SpellTypeIs(SpellType.Projectile) & ~MetamagicExclusionSpells() & ~IsSpellChildOrVariantFromContext('Projectile_WitchBolt') & ~IsSpellChildOrVariantFromContext('Projectile_ChainLightning')
    if not SpellTypeIs(SpellType.Projectile).Result                     then return ConditionResult(false) end
    if NumberOfTargetsGreaterThan(1).Result                             then return ConditionResult(false) end
    if AreaRadiusGreaterThan(0).Result                                  then return ConditionResult(false) end
    if IsSpellChildOrVariantFromContext('Projectile_WitchBolt').Result  then return ConditionResult(false) end
    if MetamagicExclusionSpells().Result                                then return ConditionResult(false) end

    if HasSpellFlag(SpellFlags.Spell).Result and TargetRadiusGreaterThan(1.5).Result then 
        return ConditionResult(true) 
    end
    return NonSpellMetamagicAbilities()
end

-- Bug Fix: Break off functionality with item spell variants and such.
function MetamagicExclusionSpells()
    if IsSpellChildOrVariantFromContext('Target_MistyStep').Result                                  then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_WildMagic_Teleport').Result                         then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_SpeakWithDead').Result                              then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_SpeakWithDead_FreeRecast').Result                   then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_SpeakWithDead_Amulet_CHA').Result                   then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Light').Result                                      then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Projectile_ChainLightning').Result                         then return ConditionResult(true) end
    -- TODO: Probably a whole lot more shit to add right here...
    if IsSpellChildOrVariantFromContext('Target_UNI_MistyStep_Nightwalkers').Result                 then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_UNI_MistyStep_DrowCommander_Amulet').Result         then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_WYR_Circus_TeleportBoots_MistyStep').Result         then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_UND_Light_Tower_Ring').Result                       then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Projectile_MAG_Legendary_Chromatic_ChainLightning').Result then return ConditionResult(true) end
    return ConditionResult(false)
end

-- ==================================== Recast spells ====================================
-- Bug Fix: Added more recast spells to the list
-- Note: Entirely irrelevant with Expansion's RAW Bladesinger. This function is only called by "Bladesong_Damage".

function IsRecastSpell()
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply').Result                        then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Strength').Result               then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Dexterity').Result              then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Constitution').Result           then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Intelligence').Result           then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Wisdom').Result                 then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Charisma').Result               then return ConditionResult(true) end
    --  Valdacil's Spell Adjustments IIRC, or was it a Syrchalis thing?
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Wildshape').Result              then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Strength_Wildshape').Result     then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Dexterity_Wildshape').Result    then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Constitution_Wildshape').Result then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Intelligence_Wildshape').Result then return ConditionResult(true) end
    if IsSpellChildOrVariantFromContext('Target_Hex_Reapply_Wisdom_Wildshape').Result       then return ConditionResult(true) end
